Include config.local

Host *
  AddKeysToAgent yes
  # Only offer keys configured here / the default identity files, instead of
  # firing every key in the agent at each host (avoids "too many auth failures").
  # Note: if you rely on agent-only keys with no matching file on disk, set this
  # to "no" for that host in ~/.ssh/config.local.
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 10

# macOS only: load passphrases from / store them to the login Keychain so keys
# survive reboots. Guarded by exec so this same file is harmless on Linux.
Match host * exec "uname | grep -q Darwin"
  UseKeychain yes
